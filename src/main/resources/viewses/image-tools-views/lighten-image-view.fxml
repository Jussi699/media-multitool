<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="media_multitool.imageTools.LightenImageController">
    <VBox alignment="TOP_CENTER"
          prefHeight="820.0"
          prefWidth="630.0"
          spacing="12.0"
          styleClass="gradient-background">

        <Label text="Lighten Image"
               styleClass="main-label-name-page">
            <VBox.margin>
                <Insets top="8.0"/>
            </VBox.margin>
        </Label>

        <HBox alignment="CENTER" spacing="20.0">
            <Button fx:id="btnSelectFile"
                    mnemonicParsing="false"
                    onAction="#onActionBtnSelectFile"
                    prefWidth="180.0"
                    text="Select image file"/>

            <Button fx:id="btnChoiceFolderForSave"
                    mnemonicParsing="false"
                    onAction="#btnChoiceFolderForSave"
                    prefWidth="180.0"
                    text="Directory for save">
                <tooltip>
                    <Tooltip text="Default directory: Desktop"/>
                </tooltip>
            </Button>
        </HBox>

        <GridPane alignment="CENTER" hgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="60.0" prefWidth="60.0" maxWidth="60.0" halignment="RIGHT"/>
                <ColumnConstraints maxWidth="400" hgrow="ALWAYS" halignment="CENTER"/>
                <ColumnConstraints minWidth="60.0" prefWidth="60.0" maxWidth="60.0" halignment="LEFT"/>
            </columnConstraints>

            <Label style="-fx-font-size: 14" styleClass="labelSuccess" GridPane.columnIndex="0">0%</Label>
            <Slider fx:id="sliderLighten" onMouseReleased="#handleSliderRelease" prefWidth="400"
                    GridPane.columnIndex="1"/>
            <Label fx:id="currentValueSlider" style="-fx-font-size: 14" styleClass="labelSuccess" GridPane.columnIndex="2">100%</Label>
        </GridPane>

        <VBox alignment="CENTER" spacing="8.0">
            <Label fx:id="labelSuccess" styleClass="labelSuccess"
                   visible="false"
                   text="Lighten status: success"/>

            <HBox alignment="CENTER" spacing="10.0">
                <Button fx:id="btnSubmit" mnemonicParsing="false"
                        onAction="#submitAndDownload"
                        prefWidth="240.0"
                        text="Download"/>
                <Button fx:id="btnSubmitAndCopy" prefWidth="180.0" text="To Clipboard"/>
            </HBox>
        </VBox>

        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets left="4.0" right="4.0"/>
            </padding>
            <VBox.margin>
                <Insets top="2.0"/>
            </VBox.margin>
            <StackPane fx:id="previewContainer" VBox.vgrow="ALWAYS" minWidth="200">
                <ImageView fx:id="imageViewPreview" preserveRatio="true"/>
                <Label fx:id="labelPreviewPlaceholder" text="Preview"/>
            </StackPane>

            <StackPane fx:id="dropZone" styleClass="drop-zone" HBox.hgrow="ALWAYS">
                <Label fx:id="textDragZone" styleClass="label-drag-zone" text="Drag image here"/>
            </StackPane>
        </VBox>

        <VBox alignment="CENTER" spacing="4.0">
            <Label fx:id="labelSelectImageName" styleClass="labelSelect"
                   text="Selected image file: none"/>

            <Button fx:id="btnReset"
                    mnemonicParsing="false"
                    onAction="#isPressedReset"
                    prefWidth="240.0"
                    text="Reset"/>
        </VBox>

        <padding>
            <Insets top="8.0" left="16.0" right="16.0" bottom="16.0"/>
        </padding>
    </VBox>

    <Button text="?"
            onAction="#showInfo"
            styleClass="info-button"
            StackPane.alignment="TOP_LEFT">
        <StackPane.margin>
            <Insets top="10.0" left="10.0"/>
        </StackPane.margin>
    </Button>
</StackPane>
