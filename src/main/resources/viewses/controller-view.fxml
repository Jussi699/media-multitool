          spacing="8.0" style="-fx-background-color: #232323;">

        <Label alignment="CENTER"
               prefWidth="200.0" styleClass="main-label-name-page" style="-fx-font-size: 22px"
               text="Multitool">
            <VBox.margin>
                <Insets top="20.0" bottom="10.0"/>
            </VBox.margin>
        </Label>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
