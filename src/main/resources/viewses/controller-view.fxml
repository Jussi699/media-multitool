                              toggleGroup="$folderGroup" prefWidth="190.0" alignment="BASELINE_LEFT">
                    <graphic>
                        <StackPane prefWidth="24.0" minWidth="24.0" prefHeight="24.0" minHeight="24.0">
                            <SVGPath
                                    content="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20 M8 12v-2a4 4 0 0 1 8 0v2 M14 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M8 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"
                                    styleClass="folder-icon"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
                <VBox fx:id="mediaToolsContent" visible="${btnMediaTools.selected}" managed="${btnMediaTools.selected}"
