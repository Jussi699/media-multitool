                    <graphic>
                        <StackPane prefWidth="24.0" minWidth="24.0" prefHeight="24.0" minHeight="24.0">
                            <SVGPath content="M12.296 3.464 l3.02 3.956 M20.2 6 L3 11 l-0.9 -2.4 c-0.3 -1.1 0.3 -2.2 1.3 -2.5 l13.5 -4 c1.1 -0.3 2.2 0.3 2.5 1.3 z M3 11 h18 v8 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 z M6.18 5.276 l3.1 3.899"
