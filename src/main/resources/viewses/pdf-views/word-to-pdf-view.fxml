<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.pdfTools.ConverterWordToPdfController">
    <VBox alignment="TOP_CENTER"
          prefHeight="820.0"
          prefWidth="630.0"
          spacing="12.0"
          styleClass="gradient-background">

        <Label styleClass="main-label-name-page" text="Word To PDF">
            <VBox.margin>
                <Insets top="8.0"/>
            </VBox.margin>
        </Label>

        <HBox alignment="CENTER" spacing="20.0">
            <Button fx:id="btnSelectFile"
                    mnemonicParsing="false"
                    onAction="#selectWordFile"
                    prefWidth="180.0"
                    text="Select Word"/>

            <Button fx:id="btnChoiceDirForSave"
                    mnemonicParsing="false"
                    onAction="#chooseSaveDirectory"
                    prefWidth="180.0"
                    text="Directory for save">

                <tooltip>
                    <Tooltip text="Default directory: Desktop"/>
                </tooltip>
            </Button>
        </HBox>

        <VBox alignment="CENTER" spacing="15.0">
            <Label fx:id="labelSuccess"
                   styleClass="labelSuccess"
                   text="Conversion status"
                   visible="false"/>

            <ProgressBar fx:id="progressBar"
                         prefWidth="240.0"
                         progress="0.0"
                         visible="false"
                         managed="false"/>

            <HBox alignment="CENTER" spacing="16.0">
                <Button fx:id="btnSubmit"
                        mnemonicParsing="false"
                        onAction="#submitAndDownload"
                        prefWidth="240.0"
                        text="Convert and Download"/>

                <Button fx:id="btnCancel"
                        mnemonicParsing="false"
                        onAction="#cancelProcessing"
                        prefWidth="240.0"
                        text="Cancel Conversion"
                        disable="true"/>
            </HBox>
        </VBox>

        <HBox spacing="5.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets left="4.0" right="4.0"/>
            </padding>

            <VBox.margin>
                <Insets top="2.0"/>
            </VBox.margin>

            <StackPane fx:id="dropZone"
                       styleClass="drop-zone, drop-zone-solo"
                       HBox.hgrow="ALWAYS">
                <Label fx:id="textDragZone" text="Drag word here"/>
            </StackPane>
        </HBox>

        <VBox alignment="CENTER" spacing="4.0">
            <Label fx:id="labelSelectFileName"
                   styleClass="labelSelect"
                   text="Selected Word file: none"/>

            <Button fx:id="btnReset"
                    mnemonicParsing="false"
                    onAction="#isPressedReset"
                    prefWidth="240.0"
                    text="Reset"/>
        </VBox>
        <padding>
            <Insets bottom="16.0" left="16.0" right="16.0" top="8.0"/>
        </padding>
    </VBox>

    <Button onAction="#showInfo"
            styleClass="info-button"
            text="?"
            StackPane.alignment="TOP_LEFT">

        <StackPane.margin>
            <Insets left="10.0" top="10.0"/>
        </StackPane.margin>
    </Button>
</StackPane>
