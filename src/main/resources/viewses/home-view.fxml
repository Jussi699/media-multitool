<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>

<?import javafx.scene.shape.SVGPath?>
<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.appControllers.HomeViewController">
    <VBox alignment="TOP_CENTER"
          styleClass="gradient-background">

        <VBox alignment="CENTER"
              spacing="8.0"
              style="-fx-padding: 30 40 20 40; -fx-background-color: linear-gradient(to bottom, #2d2d2d, #1a1a1a);">

            <Label alignment="CENTER"
                   styleClass="main-label-name-page"
                   style="-fx-font-size: 36"
                   text="Media Multitool"/>

            <Label alignment="CENTER"
                   style="-fx-font-size: 14px; -fx-text-fill: #b0b0b0;"
                   text="Professional media conversion and editing tools"
                   wrapText="true"/>
        </VBox>

        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    styleClass="gradient-background"
                    VBox.vgrow="ALWAYS">

            <VBox spacing="20.0"
                  styleClass="gradient-background"
                  style="-fx-padding: 20 40 30 40;">

                <VBox spacing="12.0" styleClass="section-container">
                    <Label text="Converter"
                           graphicTextGap="8.0"
                           styleClass="section-title"
                           xmlns="http://javafx.com/javafx"
                           xmlns:fx="http://javafx.com/fxml">

                        <graphic>
                            <SVGPath styleClass="section-icon"
                                     content="M12.296 3.464 l3.02 3.956 M20.2 6 L3 11 l-0.9 -2.4 c-0.3 -1.1 0.3 -2.2 1.3 -2.5 l13.5 -4 c1.1 -0.3 2.2 0.3 2.5 1.3 z M3 11 h18 v8 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 z M6.18 5.276 l3.1 3.899"/>
                        </graphic>
                    </Label>

                    <FlowPane hgap="14.0"
                              vgap="14.0"
                              styleClass="flowpane-home-page">

                        <Button id="btnImageConverter"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Image Converter"/>

                        <Button id="btnVideoConverter"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Video Converter"/>

                        <Button id="btnAudioConverter"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Audio Converter"/>
                    </FlowPane>
                </VBox>

                <VBox spacing="12.0" styleClass="section-container">
                    <Label text="Compressors"
                           graphicTextGap="8.0"
                           styleClass="section-title"
                           xmlns="http://javafx.com/javafx"
                           xmlns:fx="http://javafx.com/fxml">

                        <graphic>
                            <SVGPath styleClass="section-icon"
                                     content="M10.3 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10l-3.1-3.1a2 2 0 0 0-2.814.014L6 21 M14 19 l3 3 v-5.5 M17 22 l3 -3 M9 7 a2 2 0 1 0 0.001 0 Z"/>
                        </graphic>
                    </Label>

                    <FlowPane hgap="14.0"
                              vgap="14.0"
                              styleClass="flowpane-home-page">

                        <Button id="btnCompressImage"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Compress Image"/>

                        <Button id="btnCompressVideo"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Compress Video"/>

                        <Button id="btnCompressPdf"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Compress PDF"/>
                    </FlowPane>
                </VBox>

                <VBox spacing="12.0" styleClass="section-container">
                    <Label text="Image Tools" styleClass="section-title">
                        <graphic>
                            <SVGPath styleClass="section-icon"
                                     content="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M9 7a2 2 0 1 0 0.001 0z M21 15l-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                        </graphic>
                    </Label>

                    <FlowPane hgap="14.0"
                              vgap="14.0"
                              styleClass="flowpane-home-page">

                        <Button id="btnNegative"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Negative"/>

                        <Button id="btnRotate"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Rotate"/>

                        <Button id="btnLighten"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Lighten"/>

                        <Button id="btnDarken"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Darken"/>

                        <Button id="btnColorize"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Colorize"/>

                        <Button id="btnBlackAndWhite"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="B&amp;W"/>

                        <Button id="btnBlur"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Blur"/>

                        <Button id="btnSpotBlur"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Spot Blur"/>

                        <Button id="btnFindPixel"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Find Pixel"/>

                        <Button id="btnColorReplace"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Color Replace"/>

                        <Button id="btnCrop"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Crop"/>
                    </FlowPane>
                </VBox>

                <VBox spacing="12.0" styleClass="section-container">
                    <Label text="PDF Tools" styleClass="section-title">
                    <graphic>
                        <SVGPath styleClass="section-icon"
                                 content="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z M14 2v5a1 1 0 0 0 1 1h5 M10 9H8 M16 13H8 M16 17H8"/>
                    </graphic>
                </Label>

                    <FlowPane hgap="14.0"
                              vgap="14.0"
                              styleClass="flowpane-home-page">

                        <Button id="btnImageToPdf"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Image to PDF"/>

                        <Button id="btnImagesToPdf"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Image(s) to PDF"/>

                        <Button id="btnPdfToImage"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="PDF to Image"/>

                        <Button id="btnRemovePagesPdf"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Remove Pages"/>

                        <Button id="btnProtectPdf"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Protect PDF"/>

                        <Button id="btnUnlockPdf"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Unlock PDF"/>

                        <Button id="btnPdfCompress"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Compress PDF"/>

                        <Button id="btnMergePdf"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Merge PDF"/>

                        <Button id="btnSplitPdf"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Split PDF"/>

                        <Button id="btnPdfToWord"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="PDF To Word"/>

                        <Button id="btnWordToPdf"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Word To PDF"/>
                    </FlowPane>
                </VBox>

                <VBox spacing="12.0" styleClass="section-container">
                    <Label text="Watermark Tools" styleClass="section-title">
                        <graphic>
                            <SVGPath styleClass="section-icon"
                                     content="M4 9.8V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2h-3 M14 2v5a1 1 0 0 0 1 1h5 M9 17v-2a2 2 0 0 0-4 0v2 M4 17h6a1 1 0 0 1 1 1v3a1 1 0 0 1 -1 1h-6a1 1 0 0 1 -1 -1v-3a1 1 0 0 1 1 -1z"/>
                        </graphic>
                    </Label>

                    <FlowPane hgap="14.0"
                              vgap="14.0"
                              styleClass="flowpane-home-page">

                        <Button id="btnWatermarkImage"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Watermark Image"/>

                        <Button id="btnWatermarkPdf"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Watermark PDF"/>

                        <Button id="btnWatermarkVideo"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Watermark Video"/>
                    </FlowPane>
                </VBox>

                <VBox spacing="12.0" styleClass="section-container">
                    <Label text="Media Tools" styleClass="section-title">
                        <graphic>
                            <SVGPath styleClass="section-icon"
                                     content="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20 M8 12v-2a4 4 0 0 1 8 0v2 M14 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0 M8 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                        </graphic>
                    </Label>

                    <FlowPane hgap="14.0"
                              vgap="14.0"
                              styleClass="flowpane-home-page">

                        <Button id="btnMediaTagEditor"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Media Tag Editor"/>

                        <Button id="btnMetadata"
                                mnemonicParsing="false"
                                onAction="#onOpenPagePressed"
                                prefWidth="160.0"
                                styleClass="tool-button"
                                text="Metadata"/>
                    </FlowPane>
                </VBox>

                <HBox alignment="CENTER">
                    <Button id="btnApplicationInfo"
                            mnemonicParsing="false"
                            onAction="#onOpenPagePressed"
                            styleClass="info-tool-button"
                            text="Application Info"/>
                </HBox>

            </VBox>
        </ScrollPane>

    </VBox>

    <Button id="btnHelp"
            text="?"
            onAction="#showInfo"
            styleClass="info-button"
            StackPane.alignment="TOP_LEFT">

        <StackPane.margin>
            <Insets top="10.0" left="10.0"/>
        </StackPane.margin>
    </Button>
</StackPane>